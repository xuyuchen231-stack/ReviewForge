# Create a local .env with setup_secret.bat; never commit or distribute credentials.
RF_BASE_URL=https://tokenharbor.ai/v1
RF_API_KEY=replace_me
RF_WRITER_MODEL=mimo-v2.6-flash:free
RF_REVIEWER_MODEL=deepseek-v4.1-flash:free
RF_FALLBACK_MODEL=deepseek-v4.1-flash:free
RF_MAX_CALLS=120
RF_MAX_OUTPUT_TOKENS=12000
# v4 uses the same RF_WRITER_MODEL and RF_REVIEWER_MODEL as v3.
# API key is configured locally through setup_secret.bat, not distributed in ZIP.
